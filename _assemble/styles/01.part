.rule-card { margin-bottom: 8px; border: 1px solid #303641; border-radius: 6px; overflow: hidden; background: #1d2129; box-shadow: 0 3px 12px rgba(0,0,0,.09); }
.rule-event-row { min-height: 38px; display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-bottom: 1px solid #303641; background: #20252e; }
.rule-index { width: 19px; height: 19px; border-radius: 4px; display: grid; place-items: center; background: #2a303b; color: #7e8795; font: 8px ui-monospace, monospace; }
.endpoint-chip { display: inline-flex; align-items: center; gap: 5px; border: 1px solid #36536e; background: rgba(65,135,190,.1); border-radius: 4px; padding: 4px 7px; color: #a8d9ff; font: 10px ui-monospace, monospace; }
.endpoint-chip.action-endpoint { border-color: #5c4d88; background: rgba(124,93,201,.1); color: #cebfff; }
.rule-spacer { flex: 1; }
.rule-actions { padding: 6px 7px 7px 38px; position: relative; }
.rule-actions::before { content: ""; position: absolute; left: 17px; top: 0; bottom: 18px; width: 1px; background: #39404c; }
.action-step { position: relative; margin: 5px 0; border: 1px solid #353b47; border-radius: 5px; background: #1a1e25; }
.action-step::before { content: ""; position: absolute; left: -22px; top: 18px; width: 21px; height: 1px; background: #39404c; }
.action-head { min-height: 34px; padding: 5px 7px; display: flex; align-items: center; gap: 7px; border-bottom: 1px solid #2d333e; }
.step-number { color: #707887; font: 8px ui-monospace, monospace; width: 16px; }
.action-ports { display: grid; grid-template-columns: minmax(0, 1fr) minmax(150px, .7fr); gap: 0; }
.port-column { padding: 7px; min-width: 0; }
.port-column + .port-column { border-left: 1px solid #2d333e; }
.port-column-title { margin-bottom: 5px; color: #747d8d; font-size: 8px; text-transform: uppercase; letter-spacing: .08em; }
.port-row { display: grid; grid-template-columns: 86px minmax(0, 1fr); gap: 5px; align-items: center; min-height: 30px; }
.port-name { display: flex; align-items: center; gap: 5px; min-width: 0; color: #b8bfca; font: 9px ui-monospace, monospace; }
.port-dot { width: 7px; height: 7px; border-radius: 50%; border: 1px solid #6f7a8a; background: #222832; flex: 0 0 auto; }
.port-dot.number { border-color: #9ecb7d; }
.port-dot.string { border-color: #d4a46f; }
.port-dot.boolean { border-color: #c58af0; }
.binding-editor { display: grid; grid-template-columns: 94px minmax(70px, 1fr); gap: 4px; }
.binding-editor select, .binding-editor input { width: 100%; min-width: 0; min-height: 25px; padding: 0 5px; font-size: 9px; background: #11151b; }
.output-target { width: 100%; min-height: 25px; font-size: 9px; background: #11151b; }
.output-value-badge { display: inline-flex; align-items: center; gap: 4px; color: #8e97a7; font-size: 9px; }
.rule-add-action { margin: 4px 0 2px; display: flex; gap: 5px; align-items: center; }
.rule-add-action select { min-width: 180px; min-height: 27px; font-size: 9px; }
.mini-button { min-height: 26px; padding: 0 8px; border: 1px solid #343a46; border-radius: 4px; background: #232832; color: #b8c0cc; font-size: 9px; }
.mini-button:hover { border-color: #515968; color: #fff; }
.text-button { border: 0; background: transparent; color: #808898; font-size: 9px; padding: 3px 5px; }
.text-button:hover { color: #dfe3ea; }
.text-button.danger:hover { color: var(--red); }
.empty-message { padding: 22px; color: #747d8c; text-align: center; font-size: 10px; border: 1px dashed #313742; border-radius: 6px; }

.preview-panel { display: grid; grid-template-rows: 50px minmax(0, 1fr) 166px; border-left: 1px solid var(--line); }
.preview { min-height: 0; overflow: auto; padding: 8px; background: #15181e; }
.preview-object { margin-bottom: 7px; border: 1px solid #303641; border-radius: 6px; overflow: hidden; background: #1d2129; }
.preview-object__title { min-height: 27px; padding: 5px 7px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #2c323d; background: #20252d; font-size: 9px; color: #9ba3b1; }
.preview-object__title code { color: #6f7887; font-size: 8px; }
.preview-object__host { min-height: 58px; padding: 12px; display: grid; place-items: center; }
.live-dot { display: inline-flex; align-items: center; gap: 5px; color: #727b89; font-size: 8px; }
.live-dot i { width: 6px; height: 6px; border-radius: 50%; background: #69717d; }
.preview-panel.is-running .live-dot i { background: var(--green); box-shadow: 0 0 7px rgba(91,214,162,.6); }
.trace-section { border-top: 1px solid var(--line); min-height: 0; background: #181b22; display: flex; flex-direction: column; }
.trace-title { height: 30px; padding: 0 8px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #292e38; color: #8c94a1; font-size: 9px; }
.trace-list { flex: 1; min-height: 0; overflow: auto; padding: 5px 7px; font: 9px/1.55 ui-monospace, monospace; }
.trace-row { display: grid; grid-template-columns: 47px 1fr; gap: 5px; padding: 2px 0; border-bottom: 1px solid #222730; color: #a2a9b5; }
.trace-kind { text-transform: uppercase; color: #6e7785; }
.trace-row.event .trace-kind { color: var(--blue); }
.trace-row.action .trace-kind { color: #c1aaff; }
.trace-row.error { color: #ffaaaa; }
.empty-inline { color: #666f7d; font-size: 9px; padding: 5px 0; }

.demo-button, .calc-button { min-width: 120px; min-height: 36px; border: 1px solid #7e68f0; border-radius: 6px; background: linear-gradient(#765eef, #624bd5); color: white; font-weight: 700; }
.demo-button:hover, .calc-button:hover { filter: brightness(1.08); }
.demo-counter, .result-display { font-size: 34px; font-variant-numeric: tabular-nums; font-weight: 750; letter-spacing: -.03em; }
.number-field, .operation-field { width: 100%; min-height: 34px; border: 1px solid #3b4350; border-radius: 5px; background: #15191f; padding: 0 8px; color: #e4e7ed; }
.object-field-wrap { width: 100%; display: grid; gap: 5px; }
.object-field-wrap label { color: #858e9c; font-size: 9px; }
.logic-object { color: #707987; font: 9px ui-monospace, monospace; text-align: center; }

.statusbar { height: 23px; display: flex; align-items: center; gap: 12px; padding: 0 9px; border-top: 1px solid #292e37; background: #181b22; color: #727b89; font-size: 8px; user-select: none; }
.statusbar > span { white-space: nowrap; }

body.is-resizing { cursor: col-resize; user-select: none; }
body.is-resizing.is-row-resizing { cursor: row-resize; }

@media (max-width: 1050px) {
  :root { --nav-width: 210px; --preview-width: 270px; }
  .brand-copy { display: none; }
  .project-switcher { margin-left: 0; padding-left: 0; border-left: 0; }
  .rule-create select { max-width: 180px; }
}

/* Studio polish */
.blackboard-header,
.blackboard-row {
  grid-template-columns: minmax(86px, 1.15fr) 74px minmax(72px, .9fr) minmax(64px, .75fr) 24px;
}
.blackboard-live-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 5px 7px;
  border: 1px solid #2d3541;
  border-radius: 4px;
  background: #12161c;
  color: #7dddb5;
  font: 10px/1.35 "Cascadia Code", Consolas, ui-monospace, monospace;
}

.calculator-form {
  width: min(100%, 280px);
  display: grid;
  grid-template-columns: minmax(0, 1fr) 54px minmax(0, 1fr);
  gap: 8px;
  align-items: center;
}
.calculator-form .calc-button {
  grid-column: 1 / -1;
  width: 100%;
  margin-top: 2px;
}
.result-card {
  width: min(100%, 280px);
  min-height: 74px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 12px 14px;
  border: 1px solid #323a47;
  border-radius: 8px;
  background: linear-gradient(180deg, #20252d, #191d24);
  box-shadow: inset 0 1px rgba(255,255,255,.025);
}
.result-card > span {
  color: #7f8998;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.rule-card:hover { border-color: #3a4250; }
.action-step:hover { border-color: #424a58; }
.splitter { touch-action: none; }
.splitter:hover { background: #202630; }

@media (max-width: 1280px) {
  .blackboard-header,
  .blackboard-row {
    grid-template-columns: minmax(84px, 1fr) 68px minmax(68px, .8fr) minmax(58px, .7fr) 24px;
  }
}

.project-manager-button { min-width: 66px; color: #cbd1db; }
.project-dialog {
  width: min(820px, calc(100vw - 48px));
  max-height: min(680px, calc(100vh - 48px));
  padding: 0;
  border: 1px solid #3a414f;
  border-radius: 12px;
  background: #181c23;
  color: var(--text);
  box-shadow: 0 30px 90px rgba(0,0,0,.55);
}
.project-dialog::backdrop { background: rgba(5, 7, 10, .72); backdrop-filter: blur(3px); }
.project-dialog-shell { display: flex; flex-direction: column; min-height: 420px; max-height: min(680px, calc(100vh - 48px)); }
.project-dialog-head { padding: 20px 22px 18px; display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 1px solid var(--line); background: linear-gradient(180deg, #20242d, #1b1f27); }
.project-dialog-head h2 { margin: 4px 0 0; font-size: 20px; letter-spacing: -.02em; }
.project-dialog-head p { margin: 7px 0 0; color: #858e9c; font-size: 11px; }
.project-dialog-toolbar { min-height: 48px; padding: 8px 14px 8px 18px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #2b313c; }
.project-dialog-toolbar strong { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: #8e97a5; }
.project-grid { flex: 1; min-height: 0; overflow: auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: start; gap: 10px; padding: 14px; }
.project-card { min-height: 104px; padding: 13px; border: 1px solid #303744; border-radius: 8px; background: #1d222a; color: var(--text); display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 11px; align-items: center; text-align: left; }
.project-card:hover { border-color: #545d6d; background: #222832; transform: translateY(-1px); }
.project-card.is-current { border-color: rgba(123,97,255,.7); box-shadow: inset 0 0 0 1px rgba(123,97,255,.16); background: rgba(123,97,255,.08); }
.project-card-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 9px; background: linear-gradient(145deg, #303746, #252a34); color: #d7dce5; font-size: 17px; font-weight: 800; }
.project-card.is-current .project-card-icon { background: linear-gradient(145deg, #806aff, #5c46d0); color: white; }
.project-card-copy { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.project-card-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
.project-card-copy small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #76808f; font: 9px ui-monospace, monospace; }
.project-card-copy em { margin-top: 5px; color: #697382; font-size: 9px; font-style: normal; }
.project-card-open { color: #9585f5; font-size: 10px; white-space: nowrap; }

@media (max-width: 720px) {
  .project-grid { grid-template-columns: 1fr; }
}

/* Object folders */
.section-actions { display: flex; gap: 5px; }
.object-tree { padding: 6px 5px; }
.folder-item {
  --tree-depth: 0;
  width: 100%; min-height: 31px; margin: 1px 0; padding: 4px 7px 4px calc(6px + var(--tree-depth) * 14px);
  display: grid; grid-template-columns: 14px 20px minmax(0, 1fr) auto; gap: 4px; align-items: center;
  border: 1px solid transparent; border-radius: 5px; background: transparent; color: #aeb6c2; text-align: left;
}
.folder-item:hover { background: #222730; }
.folder-item.is-selected { border-color: #3f4654; background: #252a33; color: #fff; }
.tree-chevron { width: 14px; color: #6f7887; font-size: 14px; text-align: center; }
.folder-glyph { color: #c6a75a; font-size: 14px; }
.folder-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10px; font-weight: 620; }
.folder-item small { color: #626c7a; font: 8px ui-monospace, monospace; }
.object-tree .object-item { --tree-depth: 0; padding-left: calc(8px + var(--tree-depth) * 14px); min-height: 40px; }
