/* Logic view switching + diagram */
.logic-heading { min-width: 250px; }
.logic-heading-row { display: flex; align-items: center; gap: 14px; }
.logic-heading-row h2 { white-space: nowrap; }
.logic-view-tabs { display: flex; align-items: center; padding: 2px; border: 1px solid #303744; border-radius: 6px; background: #171a20; }
.logic-view-tab { height: 24px; padding: 0 9px; border: 0; border-radius: 4px; background: transparent; color: #737d8c; font-size: 9px; }
.logic-view-tab:hover { color: #c9d0da; }
.logic-view-tab.is-active { background: #2a303a; color: #fff; box-shadow: inset 0 0 0 1px #3c4552; }
.logic-workspace-view { display: none; flex: 1; min-height: 0; }
.logic-workspace-view.is-active { display: flex; }
.logic-workspace-view .rule-list { width: 100%; }
.diagram-tools { display: flex; align-items: center; gap: 9px; }
.diagram-tools[hidden], .rule-create[hidden] { display: none !important; }
.diagram-legend { display: inline-flex; align-items: center; gap: 5px; color: #737c8b; font-size: 8px; }
.diagram-legend i { width: 7px; height: 7px; border-radius: 50%; display: inline-block; margin-left: 4px; }
.diagram-legend i.event { background: #55a9e9; }
.diagram-legend i.action { background: #9a7df0; }
.diagram-legend i.board { background: #62c598; }
.diagram-canvas {
  position: relative; flex: 1; min-width: 0; min-height: 0; overflow: auto;
  background-color: #11151b;
  background-image: radial-gradient(circle at 1px 1px, #2a3039 1px, transparent 1px);
  background-size: 20px 20px;
}
.diagram-canvas > .empty-message { margin: 20px; width: calc(100% - 40px); }
.diagram-world { position: relative; min-width: 100%; min-height: 100%; }
.diagram-edges { position: absolute; inset: 0; overflow: visible; pointer-events: none; }
.diagram-edge { fill: none; stroke-width: 1.5; opacity: .9; }
.diagram-edge.flow { stroke: #586271; }
.diagram-edge.data { stroke: #4f9dd7; stroke-width: 1.7; }
.diagram-edge.blackboard { stroke: #54b68a; }
#arrow-flow path { fill: #697483; }
#arrow-data path { fill: #5aaee8; }
#arrow-board path { fill: #5ec596; }
.diagram-edge-label { font: 8px "Cascadia Code", Consolas, monospace; text-anchor: middle; paint-order: stroke; stroke: #11151b; stroke-width: 4px; }
.diagram-edge-label.data { fill: #77bff0; }
.diagram-edge-label.blackboard { fill: #77d1a9; }
.diagram-node {
  position: absolute; border: 1px solid #3a424f; border-radius: 7px; overflow: hidden;
  background: linear-gradient(180deg, #20252d, #1a1e25); box-shadow: 0 7px 22px rgba(0,0,0,.22);
  color: #dce1e9;
}
.diagram-node.event { border-color: #365b76; box-shadow: 0 7px 22px rgba(24,91,139,.12); }
.diagram-node.action { border-color: #574b7f; box-shadow: 0 7px 22px rgba(91,66,153,.12); }
.diagram-node.blackboard { border-color: #35694f; box-shadow: 0 7px 22px rgba(45,119,82,.1); }
.diagram-node header { height: 26px; padding: 0 8px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #303743; background: rgba(255,255,255,.015); }
.diagram-node header span { font: 700 7px ui-monospace, monospace; letter-spacing: .12em; color: #7e8796; }
.diagram-node.event header span { color: #70b7e7; }
.diagram-node.action header span { color: #b09bf0; }
.diagram-node.blackboard header span { color: #72cda3; }
.diagram-node header small { max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #697382; font-size: 8px; }
.diagram-node > strong { display: block; padding: 9px 10px 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 600 10px "Cascadia Code", Consolas, monospace; }
.diagram-node-ports { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 2px 9px 9px; }
.diagram-node-ports > div { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.diagram-node-ports > div:last-child { align-items: flex-end; }
.diagram-port { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #7e8897; font: 8px ui-monospace, monospace; }
.diagram-port.input { color: #aeb6c3; }
.diagram-port.output { color: #91b9dc; text-align: right; }

/* Real calculator demo */
.preview-object__host:has(.real-calculator) { padding: 14px 10px 18px; background: radial-gradient(circle at 50% 0%, #272c36, #171a20 65%); }
.real-calculator {
  width: min(100%, 272px); padding: 13px; border: 1px solid #3a414c; border-radius: 14px;
  background: linear-gradient(160deg, #20242b, #15181e 70%);
  box-shadow: inset 0 1px rgba(255,255,255,.055), 0 18px 38px rgba(0,0,0,.3);
}
.real-calculator__screen { min-height: 98px; padding: 10px 8px 11px; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-end; border-bottom: 1px solid #303640; margin-bottom: 10px; }
.real-calculator__memory { min-height: 17px; color: #8d7df0; font: 9px ui-monospace, monospace; }
.real-calculator__expression { min-height: 18px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #727b89; font: 10px ui-monospace, monospace; }
.real-calculator__display { width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; color: #f4f6f9; font: 500 34px/1.15 "Segoe UI", sans-serif; letter-spacing: -.04em; }
.real-calculator__keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
.real-calculator__key { height: 37px; padding: 0; border: 1px solid #343a45; border-radius: 7px; background: linear-gradient(#2a2f38, #232730); color: #dfe3e9; font-size: 12px; box-shadow: inset 0 1px rgba(255,255,255,.035); }
.real-calculator__key:hover { border-color: #505968; background: #303640; }
.real-calculator__key:active { transform: translateY(1px); filter: brightness(.9); }
.real-calculator__key.is-operator { border-color: #594e87; color: #c9bbff; background: linear-gradient(#312d43, #28243a); }
.real-calculator__key.is-memory { height: 30px; color: #9aa4b3; font-size: 9px; background: #1d2128; }
.real-calculator__key.is-control { color: #e5b5a0; }
.real-calculator__key.is-zero { grid-column: span 1; }
.real-calculator__key.is-equals { grid-column: span 2; border-color: #725cff; background: linear-gradient(#765ff0, #5d48cf); color: #fff; font-weight: 700; }

/* Project manager actions */
.project-card { cursor: default; }
.project-card-actions { display: flex; flex-direction: column; gap: 7px; align-items: stretch; }
.project-card-open, .project-card-reveal { min-width: 62px; height: 28px; padding: 0 8px; border: 1px solid #373f4c; border-radius: 5px; background: #222731; color: #aeb7c5; font-size: 9px; }
.project-card-open { border-color: #55478c; color: #c2b4ff; background: rgba(111,86,185,.1); }
.project-card-open:hover, .project-card-reveal:hover { border-color: #667080; color: #fff; }

@media (max-width: 1180px) {
  .logic-heading { min-width: 180px; }
  .logic-heading-row { gap: 8px; }
  .logic-view-tab { padding: 0 6px; }
  .diagram-legend { display: none; }
}
