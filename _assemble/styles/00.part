:root {
  color-scheme: dark;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --bg: #111318;
  --chrome: #181b22;
  --panel: #1b1e26;
  --panel-2: #20242d;
  --panel-3: #262b35;
  --editor: #12151b;
  --line: #303541;
  --line-soft: #272c35;
  --text: #e7eaf0;
  --muted: #8d95a5;
  --faint: #626a79;
  --accent: #7b61ff;
  --accent-2: #5f46dd;
  --accent-soft: rgba(123, 97, 255, .16);
  --green: #5bd6a2;
  --blue: #67b7ff;
  --yellow: #e9c46a;
  --red: #ff7474;
  --nav-width: 252px;
  --preview-width: 326px;
  --logic-height: 330px;
  --radius: 7px;
  background: var(--bg);
  color: var(--text);
}

* { box-sizing: border-box; }
html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: var(--bg); }
button, input, select, textarea { font: inherit; }
button, select, input { color: var(--text); }
button { cursor: pointer; }
button:disabled { opacity: .42; cursor: default; }

.titlebar {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 10px;
  border-bottom: 1px solid var(--line);
  background: linear-gradient(180deg, #1b1e26, #171a21);
  user-select: none;
}
.brand-mark {
  width: 28px; height: 28px; border-radius: 7px; display: grid; place-items: center;
  font-weight: 850; font-size: 13px; color: white; background: linear-gradient(145deg, #8a72ff, #5b43d8);
  box-shadow: inset 0 1px rgba(255,255,255,.18), 0 4px 18px rgba(75,55,190,.25);
}
.brand-copy { display: flex; flex-direction: column; min-width: 176px; line-height: 1.05; }
.brand-copy strong { font-size: 12px; font-weight: 720; }
.brand-copy span { font-size: 9px; color: var(--muted); margin-top: 3px; letter-spacing: .04em; }
.project-switcher { display: flex; align-items: center; gap: 7px; margin-left: 6px; padding-left: 12px; border-left: 1px solid var(--line); }
.toolbar-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
.titlebar-spacer, .statusbar-spacer, .editor-tab-spacer { flex: 1; }

select, .text-input {
  border: 1px solid #353b48; background: #20242d; border-radius: 5px; outline: none;
  min-height: 30px; padding: 0 9px; font-size: 12px;
}
select:focus, .text-input:focus { border-color: #725cff; box-shadow: 0 0 0 2px rgba(123,97,255,.11); }
.project-switcher select { width: 190px; }

.tool-button, .toolbar-button, .icon-button, .text-button {
  border: 1px solid var(--line); background: #222630; border-radius: 5px; color: var(--text);
}
.tool-button { width: 30px; height: 30px; padding: 0; font-size: 17px; }
.toolbar-button { min-height: 30px; padding: 0 11px; font-size: 11px; }
.toolbar-button:hover, .tool-button:hover, .icon-button:hover { border-color: #4a5261; background: #292e39; }
.toolbar-button.accent, .run-button { background: var(--accent-2); border-color: #725cff; color: white; font-weight: 700; }
.toolbar-button.accent:hover, .run-button:hover { background: #6d54eb; }
.toolbar-button.small { min-height: 26px; padding: 0 8px; }
.play-icon { font-size: 9px; margin-right: 4px; }
kbd { margin-left: 7px; border: 1px solid #454b59; border-bottom-color: #555d6c; border-radius: 3px; padding: 1px 4px; color: #aeb5c2; font: 9px/1.2 ui-monospace, monospace; }
.status-pill { font-size: 10px; color: var(--muted); padding: 4px 8px; border-radius: 10px; background: #20242d; border: 1px solid #2e3440; }
.status-pill.is-error { color: #ffc0c0; border-color: #713d48; background: #341f25; }

.app-shell {
  height: calc(100vh - 48px - 23px);
  display: grid;
  grid-template-columns: 48px var(--nav-width) 4px minmax(520px, 1fr) 4px var(--preview-width);
  min-height: 0;
}
.panel-flat { min-width: 0; min-height: 0; background: var(--panel); overflow: hidden; }
.activity-bar { background: #15181f; border-right: 1px solid var(--line); display: flex; flex-direction: column; align-items: stretch; padding-top: 6px; }
.activity-button { height: 58px; padding: 6px 2px; border: 0; border-left: 2px solid transparent; background: transparent; color: #7f8796; display: flex; flex-direction: column; align-items: center; gap: 3px; }
.activity-button:hover { color: #cdd2db; background: #1c2028; }
.activity-button.is-active { color: #fff; background: #1e222b; border-left-color: var(--accent); }
.activity-glyph { font-size: 19px; line-height: 1; }
.activity-button small { font-size: 8px; }

.navigator { border-right: 1px solid var(--line); display: flex; flex-direction: column; }
.navigator-view { display: none; flex-direction: column; min-height: 0; height: 100%; }
.navigator-view.is-active { display: flex; }
.section-titlebar, .preview-titlebar, .logic-titlebar {
  min-height: 50px; padding: 9px 10px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between;
  background: #1d2028;
}
.section-titlebar h2, .preview-titlebar h2, .logic-titlebar h2 { margin: 2px 0 0; font-size: 12px; font-weight: 700; }
.eyebrow { display: block; color: var(--muted); font-size: 8px; letter-spacing: .13em; }
.icon-button { width: 27px; height: 27px; padding: 0; font-size: 15px; }
.filter-row { padding: 7px; border-bottom: 1px solid var(--line-soft); }
.compact-input { width: 100%; min-height: 28px; font-size: 11px; }
.object-list { flex: 1; min-height: 0; padding: 6px; overflow: auto; }
.object-item { width: 100%; min-height: 44px; margin-bottom: 3px; padding: 7px 8px; text-align: left; border: 1px solid transparent; border-radius: 5px; background: transparent; color: var(--text); display: grid; grid-template-columns: 28px 1fr; gap: 8px; align-items: center; }
.object-item:hover { background: #232730; }
.object-item.is-active { background: var(--accent-soft); border-color: rgba(123,97,255,.36); }
.object-icon { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 5px; background: #2a2f3a; color: #b8c0cc; font: 700 9px ui-monospace, monospace; }
.object-item.is-active .object-icon { background: #5947be; color: white; }
.object-copy { min-width: 0; }
.object-copy strong { display: block; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.object-copy small { display: block; margin-top: 2px; color: var(--muted); font-size: 9px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.navigator-footer { padding: 9px 10px; border-top: 1px solid var(--line); color: #707887; font-size: 9px; line-height: 1.45; }

.blackboard-header { display: grid; grid-template-columns: 1.2fr .8fr 1fr 24px; gap: 5px; padding: 7px 8px; color: var(--muted); border-bottom: 1px solid var(--line-soft); font-size: 8px; text-transform: uppercase; letter-spacing: .06em; }
.blackboard-list { flex: 1; min-height: 0; overflow: auto; padding: 5px; }
.blackboard-row { display: grid; grid-template-columns: 1.2fr .8fr 1fr 24px; gap: 5px; align-items: center; padding: 4px 3px; border-bottom: 1px solid #252a33; }
.blackboard-row input, .blackboard-row select { width: 100%; min-width: 0; min-height: 27px; padding: 0 6px; font-size: 10px; background: #171a21; }
.delete-mini { width: 24px; height: 24px; border: 0; background: transparent; color: #808897; border-radius: 4px; }
.delete-mini:hover { color: var(--red); background: rgba(255,116,116,.08); }

.splitter { position: relative; background: #15181e; z-index: 4; }
.splitter::after { content: ""; position: absolute; inset: 0; transition: background .12s; }
.splitter:hover::after, body.is-resizing .splitter::after { background: rgba(123,97,255,.55); }
.splitter-vertical { cursor: col-resize; border-left: 1px solid #222731; border-right: 1px solid #222731; }
.splitter-horizontal { cursor: row-resize; border-top: 1px solid #222731; border-bottom: 1px solid #222731; }

.center-workspace { min-width: 0; min-height: 0; display: grid; grid-template-rows: minmax(220px, 1fr) 4px var(--logic-height); background: #15171d; }
.code-panel { display: flex; flex-direction: column; min-height: 0; }
.editor-tabs { height: 36px; display: flex; align-items: center; border-bottom: 1px solid var(--line); background: #1c1f27; }
.editor-tab { height: 36px; min-width: 180px; padding: 0 10px; display: flex; align-items: center; gap: 7px; font-size: 10px; border-right: 1px solid var(--line); color: #dce0e8; }
.editor-tab.is-active { background: var(--editor); box-shadow: inset 0 1px var(--accent); }
.ts-badge { display: grid; place-items: center; width: 20px; height: 17px; border-radius: 3px; background: #2767a9; color: white; font: 700 8px ui-monospace, monospace; }
.dirty-dot { width: 6px; height: 6px; border-radius: 50%; background: transparent; margin-left: auto; }
.dirty-dot.is-visible { background: var(--yellow); }
.editor-status { margin-right: 8px; color: var(--muted); font-size: 9px; }
.editor-status.is-error { color: var(--red); }
.editor-host { flex: 1; min-height: 0; background: var(--editor); }

.code-editor { height: 100%; min-height: 0; display: grid; grid-template-columns: 50px 1fr; grid-template-rows: 1fr 22px; overflow: hidden; background: var(--editor); }
.code-editor__viewport { position: relative; min-width: 0; min-height: 0; overflow: hidden; }
.code-editor__lines, .code-editor__highlight, .code-editor__input {
  margin: 0; font: 12px/1.6 "Cascadia Code", "SFMono-Regular", Consolas, ui-monospace, monospace; tab-size: 2; white-space: pre;
}
.code-editor__lines { grid-row: 1; padding: 11px 10px 24px 0; text-align: right; color: #4f5869; background: #101319; border-right: 1px solid #222731; user-select: none; will-change: transform; }
.code-editor__viewport { grid-row: 1; }
.code-editor__highlight { position: absolute; top: 0; left: 0; min-width: 100%; min-height: 100%; padding: 11px 14px 40px; color: #cdd3dd; pointer-events: none; will-change: transform; }
.code-editor__input { position: absolute; inset: 0; width: 100%; height: 100%; padding: 11px 14px 40px; resize: none; border: 0; outline: none; background: transparent; color: transparent; -webkit-text-fill-color: transparent; caret-color: #f5f7fb; overflow: auto; white-space: pre; }
.code-editor__input::selection { background: rgba(87, 126, 214, .38); }
.code-editor__cursor-position { grid-column: 1 / -1; grid-row: 2; height: 22px; padding: 3px 9px; border-top: 1px solid #242934; background: #171a21; text-align: right; color: #6f7785; font: 9px/15px ui-monospace, monospace; }
.code-editor.is-readonly { opacity: .6; }
.tok-comment { color: #697486; font-style: italic; }
.tok-string, .tok-template { color: #d9a26f; }
.tok-number { color: #a7d087; }
.tok-keyword { color: #c792ea; }
.tok-type { color: #76d6cf; }
.tok-builtin { color: #82aaff; }
.tok-function { color: #82b7ff; }
.tok-operator { color: #89ddff; }
.tok-punctuation { color: #8991a1; }
.tok-identifier { color: #d8dce4; }

.api-summary { min-height: 38px; padding: 6px 9px; display: flex; gap: 12px; align-items: center; overflow-x: auto; border-top: 1px solid var(--line); background: #181b22; }
.api-group { display: flex; align-items: center; gap: 5px; white-space: nowrap; }
.api-label { color: #6f7785; font-size: 8px; text-transform: uppercase; letter-spacing: .06em; }
.api-chip { border: 1px solid #343a46; border-radius: 10px; padding: 2px 6px; background: #222630; color: #bcc3cf; font: 9px ui-monospace, monospace; }
.api-chip.event { border-color: #31516d; color: #86c4fa; background: rgba(55,118,170,.12); }
.api-chip.action { border-color: #594b88; color: #c4b5fd; background: rgba(111,86,185,.13); }

.logic-panel { min-height: 0; display: flex; flex-direction: column; }
.logic-titlebar { min-height: 48px; padding: 7px 10px; }
.logic-heading { min-width: 116px; }
.rule-create { display: flex; align-items: center; gap: 6px; min-width: 0; }
.rule-create select { min-width: 150px; max-width: 240px; height: 28px; font-size: 10px; }
.flow-arrow { color: var(--muted); font-size: 13px; }
.rule-list { flex: 1; min-height: 0; overflow: auto; padding: 8px; background: #171a21; }
