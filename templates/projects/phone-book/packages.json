      "specifier": "npm:typeorm@1.1.0",
      "role": "runtime",
      "permissions": { "env": ["TINYGLOBBY_DEBUG"] }
    },
    {
      "id": "reflect-metadata",
      "alias": "reflect-metadata",
      "specifier": "npm:reflect-metadata@0.2.2",
