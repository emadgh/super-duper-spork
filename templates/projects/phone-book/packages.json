      "permissions": { "ffi": true }
    },
    {
      "id": "tailwindcss",
      "alias": "tailwindcss",
      "specifier": "npm:tailwindcss@4.3.3",
      "role": "build"
    },
    {
      "id": "tailwindcss-cli",
      "alias": "@tailwindcss/cli",
      "specifier": "npm:@tailwindcss/cli@4.3.3",
      "role": "build"
